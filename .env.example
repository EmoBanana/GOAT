GOAT_PORT=8402
OLLAMA_HOST=http://127.0.0.1:11434
GOAT_MODEL=gemma4:e4b-it-qat
GOAT_MODEL_PRO=gemma4:e4b-it-qat  # gemma4:12b is better but won't stay loaded beside E4B on 16 GB
GOAT_STT_MODEL=gemma4:e4b-it-qat
OLLAMA_KEEP_ALIVE=30m
GOAT_PAYMENTS=x402-local          # off | x402-local | x402
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=
GOAT_PRICE_USD=0.01
GOAT_PRO_PRICE_USD=1.00
GOAT_PRO_DAYS=30
MYR_PER_USD=4.20                  # demo constant, set to today's rate
GOAT_WELCOME_CREDIT_MYR=2
TOPUP_MODE=mock                   # mock | cdp-faucet | treasury
TREASURY_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
GOAT_SERVER_URL=http://127.0.0.1:8402
GOAT_WINDOW_LEVEL=modal-panel      # screen-saver also covers the menu bar but breaks macOS screenshots
GOAT_WALLET=auto                  # auto (CDP if keys set) | local | cdp | none
GOAT_TRACK_INTERVAL_SEC=10
GOAT_IDLE_SEC=300
