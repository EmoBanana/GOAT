{
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server@2.1.4", "--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}",
        "BRAVE_MCP_ENABLED_TOOLS": "brave_web_search",
        "BRAVE_MCP_LOG_LEVEL": "error"
      },
      "tools": ["brave_web_search"]
    }
  }
}
